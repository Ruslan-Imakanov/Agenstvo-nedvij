# Сайт ТОО «MEDIA Информ Плюс» на hoster.kz (Plesk, Apache). Заменяет _headers и воркер Cloudflare.
# Если после загрузки сайт отвечает ошибкой 500 — удалите строку «Options -Indexes» и попробуйте снова.

DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Короткие адреса без «.html» (/privacy → /privacy.html) и /api/lead → /api/lead.php
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^api/lead/?$ api/lead.php [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>
